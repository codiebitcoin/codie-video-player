{
  "id": "youtube",
  "name": "YouTube",
  "version": "0.3.11",
  "minAppVersion": "0.1.0",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "accounts.google.com",
      "www.youtube.com",
      "youtube.com"
    ],
    "process": [
      "yt-dlp",
      "bin/yt-dlp",
      "/opt/homebrew/bin/yt-dlp",
      "/usr/local/bin/yt-dlp"
    ]
  }
}
