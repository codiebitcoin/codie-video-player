{
  "id": "niconico",
  "name": "NicoNico",
  "version": "0.1.1",
  "minAppVersion": "0.1.22",
  "kind": "video",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "www.nicovideo.jp",
      "nicovideo.jp",
      "nvapi.nicovideo.jp",
      "snapshot.search.nicovideo.jp",
      "*.nicovideo.jp",
      "*.nimg.jp",
      "*.dmc.nico"
    ],
    "process": [
      "yt-dlp",
      "bin/yt-dlp",
      "/opt/homebrew/bin/yt-dlp",
      "/usr/local/bin/yt-dlp"
    ]
  },
  "requestHeaders": [
    {
      "hosts": [
        "*.nimg.jp"
      ],
      "kinds": [
        "image"
      ],
      "headers": {
        "Referer": "https://www.nicovideo.jp/"
      }
    }
  ]
}
